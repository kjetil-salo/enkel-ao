# Ignorer miljøvariabler og lokale hemmeligheter
.env

# Fellestur-føderasjon: eget inbound-secret og peer-config.
# Prod/staging lagrer disse på /data (docker-volum) uansett, ikke i
# repo-mappen — men ekskludert her også i tilfelle noen kjører lokalt
# uten env-override og filene havner i repo-roten.
.fellestur_peer_secret
fellestur_peer_secret.txt
fellestur_peer_providers.json

# Lokale SQLite-databaser (DB_PATH / LOCATION_DB_PATH ved lokal utvikling).
# I drift ligger disse på docker-volumet /data, aldri i repo-mappen.
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE / venv / caches
.venv
*.pyc
__pycache__/
.coverage
.pytest_cache/
.DS_Store
# .claude/ er lokal som hovedregel (sesjoner, settings.local.json,
# prod-/deploy-skills). Unntaket er de tre som beskriver selve APPEN og
# som bidragsytere trenger — de deles i repoet.
# NB: unntakene må gjøres nivå for nivå; git traverserer ikke inn i en
# katalog som er ignorert i sin helhet, så `.claude/` kan ikke stå alene.
# NB2: har du `.claude/` i din egen globale gitignore, overstyrer den disse
# unntakene for NYE filer — de tre ble derfor lagt til med `git add -f` én
# gang. Sporede filer påvirkes ikke av gitignore, så de oppdateres normalt.
.claude/*
!.claude/agents/
!.claude/skills/
.claude/agents/*
!.claude/agents/test.md
.claude/skills/*
!.claude/skills/agent-software-developer/
!.claude/skills/agent-solution-architect/

.codex/
.codex-tmp/

# Arbeidsmapper fra andre AI-verktoy (Google AI Studio, Cursor, Copilot-agenter).
# Planer og mellomnotater fra et verktoy er ikke en del av appen og skal ikke
# folge med i en PR - se AGENTS.md.
.aistudio/
.cursor/
.gemini/

# Node.js
node_modules/
dist/
*.log

# Lokale Playwright-hjelpeskript
tests/e2e_playwright/*debug*.js
tests/e2e_playwright/screenshot-staging*.js
tests/e2e_playwright/samsung-*.js

# Playwright-testartefakter (regenereres ved hver kjøring)
tests/e2e_playwright/test-results/
tests/e2e_playwright/playwright-report/
